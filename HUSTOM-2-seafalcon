# HUSTOM EMPIRE ASCII LOGO - Shows in every run
HUSTOM_LOGO = """
   🦅 HUSTOM EMPIRE 🦅
  \\  \\  /  /  \\  \\  /  /
   \\  \\/  \\/  /  /
    \\  FALCON  /
     \\  /  \\  /
      \\/    \\/
  HUSTOM-1 NIGHTFALCON
  Zanzibar -> Oxford -> Orbit
"""

def show_logo():
    print(HUSTOM_LOGO)
    print("="*50)
    print("HUSTOM EMPIRE | HUSTOM-1 NIGHTFALCON")
    print("="*50)

class Nightfalcon:
    def __init__(self):
        self.logo = "HUSTOM EMPIRE"
        self.mode = "IDLE"
        self.fuel = 100
        self.altitude = 0
        self.endurance = 0

    def show_brand(self):
        print(f"[{self.logo}] HUSTOM-1 NIGHTFALCON - Mode: {self.mode}")

    def mission(self, hours):
        show_logo()
        missions = {
            12: {"name": "12HR Extended Loiter", "range": 900, "fuel": "Standard + Aux"},
            18: {"name": "18HR Long Range", "range": 1400, "fuel": "Extended + Standard"},
            24: {"name": "24HR Max Endurance", "range": 1100, "fuel": "Max + Aux Pack"},
        }
        m = missions.get(hours, missions[12])
        print(f"[{self.logo}] Starting Mission: {m['name']}")
        print(f"[{self.logo}] Range: {m['range']} km | Fuel: {m['fuel']}")
        print(f"[{self.logo}] Endurance: {hours} HR")
        # Simulate mission
        for h in range(1, hours+1):
            self.fuel = max(0, 100 - (100*h//hours))
            if h % 6 == 0 or h == hours:
                print(f"[{self.logo}] Hour {h}/{hours} | Fuel {self.fuel}% | Alt 20000m")
        print(f"[{self.logo}] Mission COMPLETE - {hours}HR Success!")
        print(f"[{self.logo}] HUSTOM EMPIRE - Thank you!")

    def eot_table(self):
        show_logo()
        print("HUSTOM EMPIRE - MODERN EOT REV 5.0")
        print("Mode | Endurance | Range | Fuel")
        print("12HR | 12 HR | 900 km | Standard + Aux")
        print("18HR | 18 HR | 1400 km | Extended + Standard")
        print("24HR | 24 HR | 1100 km | Max + Aux Pack")
        print("CIVILIAN - FOR PLANNING")

if __name__ == "__main__":
    show_logo()
    jet = Nightfalcon()
    jet.eot_table()
    print("")
    jet.mission(12)
    print("")
    print("🦅 HUSTOM EMPIRE - From Zanzibar to Orbit 🦅")
